class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int cnt1 = 0;
        int cnt2 = 0;
        int el1 = INT_MIN;
        int el2 = INT_MIN;
        vector<int> ans;

        for(int i = 0;i < nums.size(); i++){
            if(cnt1 == 0 and nums[i] != el2){
                cnt1++;
                el1 = nums[i];
            }
            else if(cnt2 == 0 and nums[i] != el1){
                cnt2++;
                el2 = nums[i];
            }
            else if(nums[i] == el1){
                cnt1++;
            }
            else if(nums[i] == el2){
                cnt2++;
            }
            else{
                cnt1--;
                cnt2--;
            }
        }

        int c1 = 0;
        int c2 = 0;

        for(int i = 0; i < nums.size(); i++){
            if(el1 == nums[i]) c1++;
            if(el2 == nums[i]) c2++;
        }

        if(c1 > nums.size()/3){
                ans.push_back(el1);
            }
        if(c2 > nums.size()/3){
                ans.push_back(el2);
            }
        sort(ans.begin(),ans.end());
        return ans;
    }
};
